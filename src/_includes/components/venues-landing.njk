<div class="hero hero--venues">
    <div class="venues-hero__content">
        <p class="venues-hero__kicker">{{ venues[lang].kicker }}</p>
        <h2>{{ venues[lang].heroTitle }} <span>{{ venues[lang].heroHighlight }}</span></h2>
        <p>{{ venues[lang].heroDescription }}</p>
        <div class="hero-actions">
            <a href="{{ venues[lang].ctaPrimaryHref }}" class="button button--filled">{{ venues[lang].ctaPrimary }}</a>
            <a href="{{ venues[lang].ctaSecondaryHref }}" target="_blank" rel="noopener" class="button">{{ venues[lang].ctaSecondary }}</a>
        </div>
        <p class="venues-hero__note">{{ venues[lang].ctaNote }}</p>
    </div>
    <div class="venues-hero__media">
        <img src="/public/img/hero-venue.jpg" alt="Cocktail menu served at a hotel or beach bar">
    </div>
</div>

<div class="in-page-title">
    <div class="in-page-title__content">
        <h3>{{ venues[lang].stepsTitle }}</h3>
        <p>{{ venues[lang].stepsSubtitle }}</p>
    </div>
</div>
<div class="venues-steps">
    {% for step in venues[lang].steps %}
    <div class="venues-step">
        <span class="venues-step__num">{{ loop.index }}</span>
        <h4>{{ step.title }}</h4>
        <p>{{ step.description }}</p>
    </div>
    {% endfor %}
</div>

<div class="in-page-title">
    <div class="in-page-title__content">
        <h3>{{ venues[lang].audienceTitle }}</h3>
        <p>{{ venues[lang].audienceSubtitle }}</p>
    </div>
</div>
<div class="venues-segments">
    {% for segment in venues[lang].segments %}
    <div class="feature">
        <div class="feature__text">
            <h3>{{ segment.title }}</h3>
            <p class="venues-segment__desc">{{ segment.description }} ⚠️</p>
            <ul>
                {% for bullet in segment.bullets %}
                <li>{{ bullet }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>
    {% endfor %}
</div>

<div class="in-page-title">
    <div class="in-page-title__content">
        <h3>{{ venues[lang].benefitsTitle }}</h3>
        <p>{{ venues[lang].benefitsSubtitle }}</p>
    </div>
</div>
<div class="features">
    {% for benefit in venues[lang].benefits %}
    <div class="feature">
        <div class="feature__icon">
            {{ venueIcon(benefit.icon) }}
        </div>
        <div class="feature__text">
            <h3>{{ benefit.title }}</h3>
            <p>{{ benefit.description }}</p>
        </div>
    </div>
    {% endfor %}
</div>

<div class="venues-cost" id="pricing">
    <div class="venues-cost__intro">
        <p class="venues-cost__kicker">{{ venues[lang].costKicker }}</p>
        <h3>{{ venues[lang].costTitle }} <span>{{ venues[lang].costHighlight }}</span></h3>
        <p class="venues-cost__lead">{{ venues[lang].costResult }}</p>
        <ul class="venues-cost__points">
            {% for point in venues[lang].costPoints %}
            <li>
                <div class="venues-cost__point-text">
                    <strong>{{ point.title }}</strong>
                    <p>{{ point.description }}</p>
                </div>
            </li>
            {% endfor %}
        </ul>
    </div>
    <div class="venues-cost__visual">
        <img class="venues-cost__photo" src="/public/img/venue-bar.jpg" alt="" loading="lazy">
        <div class="venues-cost__card">
            <p class="venues-cost__card-kicker">{{ venues[lang].costCardKicker }}</p>
            <h4>{{ venues[lang].costCardTitle }}</h4>
            <h5>{{ venues[lang].costRecipeName }}</h5>
            <table class="venues-cost__table">
                <thead>
                    <tr>
                        <th>{{ venues[lang].costHeadLeft }}</th>
                        <th>{{ venues[lang].costHeadRight }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in venues[lang].costRows %}
                    <tr>
                        <td>{{ row.name }}</td>
                        <td class="venues-cost__amount">{{ row.amount }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <th>{{ venues[lang].costTotalName }}</th>
                        <th class="venues-cost__amount">{{ venues[lang].costTotalAmount }}</th>
                    </tr>
                </tfoot>
            </table>
            <p class="venues-cost__suggest-title">{{ venues[lang].priceSuggestTitle }}</p>
            <div class="venues-cost__prices">
                {% for row in venues[lang].priceSuggestRows %}
                <div class="venues-cost__price">
                    <span>{{ row.name }}</span>
                    <strong>{{ row.amount }}</strong>
                </div>
                {% endfor %}
            </div>
            <p class="venues-cost__note">{{ venues[lang].costNote }}</p>
        </div>
    </div>
</div>

<div class="in-page-title" id="plans">
    <div class="in-page-title__content">
        <h3>{{ venues[lang].planTitle }}</h3>
        <p>{{ venues[lang].planSubtitle }}</p>
    </div>
</div>
<div class="venues-plans">
    <div class="venues-plan venues-plan--free">
        <h3>{{ venues[lang].planFree.name }}</h3>
        <div class="venues-plan__price">
            <h4>{{ venues[lang].planFree.price }}</h4>
            <small>{{ venues[lang].planFree.billing }}</small>
        </div>
        <p class="venues-plan__tagline">{{ venues[lang].planFree.tagline }}</p>
        <ul>
            {% for feature in venues[lang].planFree.bullets %}
            <li>{{ feature }}</li>
            {% endfor %}
        </ul>
        <div class="venues-plan__action">
            <a href="{{ venues[lang].planFree.ctaHref }}" class="button">{{ venues[lang].planFree.ctaText }}</a>
        </div>
    </div>
    <div class="venues-plan venues-plan--paid">
        <h3>{{ venues[lang].planPaid.name }}</h3>
        <div class="venues-plan__price">
            <h4>{{ venues[lang].planPaid.price }}</h4>
            <small>{{ venues[lang].planPaid.billing }}</small>
        </div>
        <p class="venues-plan__tagline">{{ venues[lang].planPaid.tagline }}</p>
        <ul>
            {% for feature in venues[lang].planPaid.bullets %}
            <li>{{ feature }}</li>
            {% endfor %}
        </ul>
        <div class="venues-plan__action">
            <a href="{{ venues[lang].planPaid.ctaHref }}" class="button button--filled">{{ venues[lang].planPaid.ctaText }}</a>
        </div>
    </div>
</div>
<p class="venues-plans__invoice">{{ venues[lang].invoiceHtml | safe }}</p>

<div class="in-page-title">
    <div class="in-page-title__content">
        <h3>{{ venues[lang].faqTitle }}</h3>
        <p>{{ venues[lang].faqSubtitle }}</p>
    </div>
</div>
<div class="page-faq" itemscope itemtype="https://schema.org/FAQPage">
    {% for item in venues[lang].faq %}
    <div class="faq__question" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
        <h5 itemprop="name">{{ item.q }}</h5>
        <p itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
            <span itemprop="text">{{ item.a | safe }}</span>
        </p>
    </div>
    {% endfor %}
</div>

<div class="venues-final">
    <h3>{{ venues[lang].finalTitle }}</h3>
    <p>{{ venues[lang].finalText }}</p>
    <div class="hero-actions">
        <a href="{{ venues[lang].finalPrimaryHref }}" class="button button--filled">{{ venues[lang].finalPrimary }}</a>
        <a href="{{ venues[lang].finalSecondaryHref }}" class="button">{{ venues[lang].finalSecondary }}</a>
    </div>
</div>
